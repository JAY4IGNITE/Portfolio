# Contact Form Integration Configuration
# Choose one of: 'emailjs', 'formspree', 'google_script', 'dev_log'
VITE_CONTACT_PROVIDER=google_script

# 1. Google Apps Script Configuration
# Already configured with your active Google Script deployment:
VITE_GOOGLE_SCRIPT_URL=

# Personal Info
VITE_PERSONAL_EMAIL=
VITE_PERSONAL_PHONE=
VITE_PERSONAL_PHONE_TEL=

# Coding Profiles
VITE_CODECHEF_USERNAME=jay4ignite
# Keep this same-origin when deploying with the included serverless API.
VITE_CODECHEF_API_URL=/api/codechef

# 2. Formspree Configuration
# Sign up at https://formspree.io and get your Form ID (e.g. xzbnkyqp)
VITE_FORMSPREE_ID=

# 3. EmailJS Configuration
# Sign up at https://www.emailjs.com and get your credentials
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
